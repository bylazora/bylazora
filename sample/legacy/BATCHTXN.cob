IDENTIFICATION DIVISION.
PROGRAM-ID. BATCHTXN.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT TXN-FILE ASSIGN TO WS-TXN-PATH
        ORGANIZATION IS LINE SEQUENTIAL.
    SELECT BAL-FILE ASSIGN TO WS-BAL-PATH
        ORGANIZATION IS LINE SEQUENTIAL.
    SELECT OUT-BAL ASSIGN TO WS-OUTBAL-PATH
        ORGANIZATION IS LINE SEQUENTIAL.
    SELECT OUT-SUM ASSIGN TO WS-OUTSUM-PATH
        ORGANIZATION IS LINE SEQUENTIAL.
DATA DIVISION.
FILE SECTION.
FD  TXN-FILE.
01  TXN-LINE      PIC X(80).
FD  BAL-FILE.
01  BAL-LINE      PIC X(80).
FD  OUT-BAL.
01  OUT-BAL-REC   PIC X(200).
FD  OUT-SUM.
01  OUT-SUM-REC   PIC X(200).
WORKING-STORAGE SECTION.
01  WS-ARGS         PIC X(600).
01  WS-TXN-PATH     PIC X(200).
01  WS-BAL-PATH     PIC X(200).
01  WS-OUT-DIR      PIC X(200).
01  WS-OUTBAL-PATH  PIC X(240).
01  WS-OUTSUM-PATH  PIC X(240).
01  WS-PARSE.
    05  WS-F-A      PIC X(24).
    05  WS-F-B      PIC X(24).
    05  WS-F-C      PIC X(24).
01  WS-D1           PIC -(18)9.
01  WS-D2           PIC -(18)9.
01  WS-D3           PIC -(18)9.
01  WS-D4           PIC -(18)9.
01  WS-D5           PIC -(18)9.
01  WS-NACC         PIC 9(7) COMP-5 VALUE 0.
01  WS-GRAND-DEP    PIC S9(18) COMP-5 VALUE 0.
01  WS-GRAND-WD     PIC S9(18) COMP-5 VALUE 0.
01  WS-GRAND-CNT    PIC S9(18) COMP-5 VALUE 0.
01  WS-GRAND-END    PIC S9(18) COMP-5 VALUE 0.
01  WS-I            PIC 9(8) COMP-5.
01  WS-ACCT         PIC 9(7) COMP-5.
01  WS-AMT          PIC S9(18) COMP-5.
01  WS-TYPE         PIC X.
01  WS-SKIP         PIC X VALUE "Y".
01  ACC-TABLE.
    05  ACC-ENTRY OCCURS 8000000 TIMES.
        10  ACC-DEP   PIC S9(18) COMP-5.
        10  ACC-WD    PIC S9(18) COMP-5.
        10  ACC-CNT   PIC S9(18) COMP-5.
        10  ACC-BAL   PIC S9(18) COMP-5.
PROCEDURE DIVISION.
MAIN.
    ACCEPT WS-ARGS FROM COMMAND-LINE
    UNSTRING WS-ARGS DELIMITED BY ALL SPACE
        INTO WS-TXN-PATH WS-BAL-PATH WS-OUT-DIR
    STRING FUNCTION TRIM(WS-OUT-DIR) "/final_balances.csv"
        INTO WS-OUTBAL-PATH
    STRING FUNCTION TRIM(WS-OUT-DIR) "/summary_report.csv"
        INTO WS-OUTSUM-PATH
    PERFORM INIT-TABLE
    PERFORM LOAD-BALANCES
    PERFORM PROCESS-TRANSACTIONS
    PERFORM WRITE-OUTPUTS
    STOP RUN.
INIT-TABLE.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 8000000
        MOVE 0 TO ACC-DEP(WS-I) ACC-WD(WS-I) ACC-CNT(WS-I) ACC-BAL(WS-I)
    END-PERFORM.
LOAD-BALANCES.
    OPEN INPUT BAL-FILE
    READ BAL-FILE
    MOVE 0 TO WS-NACC
    MOVE "N" TO WS-SKIP
    PERFORM UNTIL WS-SKIP = "E"
        READ BAL-FILE INTO BAL-LINE
        AT END MOVE "E" TO WS-SKIP
        NOT AT END
            UNSTRING BAL-LINE DELIMITED BY "," INTO WS-F-A WS-F-B
            COMPUTE WS-ACCT = FUNCTION NUMVAL(WS-F-A)
            COMPUTE WS-AMT = FUNCTION NUMVAL(WS-F-B)
            MOVE WS-AMT TO ACC-BAL(WS-ACCT + 1)
            IF WS-ACCT > WS-NACC MOVE WS-ACCT TO WS-NACC END-IF
        END-READ
    END-PERFORM
    CLOSE BAL-FILE.
PROCESS-TRANSACTIONS.
    OPEN INPUT TXN-FILE
    READ TXN-FILE
    MOVE "N" TO WS-SKIP
    PERFORM UNTIL WS-SKIP = "E"
        READ TXN-FILE INTO TXN-LINE
        AT END MOVE "E" TO WS-SKIP
        NOT AT END
            UNSTRING TXN-LINE DELIMITED BY "," INTO WS-F-A WS-F-B WS-F-C
            COMPUTE WS-ACCT = FUNCTION NUMVAL(WS-F-A)
            COMPUTE WS-AMT = FUNCTION NUMVAL(WS-F-B)
            MOVE WS-F-C(1:1) TO WS-TYPE
            IF WS-TYPE = "D"
                ADD WS-AMT TO ACC-DEP(WS-ACCT + 1)
                ADD WS-AMT TO ACC-BAL(WS-ACCT + 1)
                ADD WS-AMT TO WS-GRAND-DEP
            ELSE
                ADD WS-AMT TO ACC-WD(WS-ACCT + 1)
                SUBTRACT WS-AMT FROM ACC-BAL(WS-ACCT + 1)
                ADD WS-AMT TO WS-GRAND-WD
            END-IF
            ADD 1 TO ACC-CNT(WS-ACCT + 1)
            ADD 1 TO WS-GRAND-CNT
        END-READ
    END-PERFORM
    CLOSE TXN-FILE.
WRITE-OUTPUTS.
    OPEN OUTPUT OUT-BAL
    MOVE SPACES TO OUT-BAL-REC
    STRING "ACCOUNT_ID,BALANCE_CENTS" INTO OUT-BAL-REC
    WRITE OUT-BAL-REC
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-NACC + 1
        COMPUTE WS-ACCT = WS-I - 1
        MOVE WS-ACCT TO WS-D1
        MOVE ACC-BAL(WS-I) TO WS-D2
        MOVE SPACES TO OUT-BAL-REC
        STRING FUNCTION TRIM(WS-D1) "," FUNCTION TRIM(WS-D2)
            INTO OUT-BAL-REC
        WRITE OUT-BAL-REC
        ADD ACC-BAL(WS-I) TO WS-GRAND-END
    END-PERFORM
    CLOSE OUT-BAL
    OPEN OUTPUT OUT-SUM
    MOVE SPACES TO OUT-SUM-REC
    STRING "ACCOUNT_ID,TOTAL_DEPOSITS,TOTAL_WITHDRAWALS,"
           "TXN_COUNT,ENDING_BALANCE" INTO OUT-SUM-REC
    WRITE OUT-SUM-REC
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-NACC + 1
        COMPUTE WS-ACCT = WS-I - 1
        MOVE WS-ACCT TO WS-D1
        MOVE ACC-DEP(WS-I) TO WS-D2
        MOVE ACC-WD(WS-I) TO WS-D3
        MOVE ACC-CNT(WS-I) TO WS-D4
        MOVE ACC-BAL(WS-I) TO WS-D5
        MOVE SPACES TO OUT-SUM-REC
        STRING FUNCTION TRIM(WS-D1) "," FUNCTION TRIM(WS-D2) ","
               FUNCTION TRIM(WS-D3) "," FUNCTION TRIM(WS-D4) ","
               FUNCTION TRIM(WS-D5) INTO OUT-SUM-REC
        WRITE OUT-SUM-REC
    END-PERFORM
    MOVE WS-GRAND-DEP TO WS-D2
    MOVE WS-GRAND-WD TO WS-D3
    MOVE WS-GRAND-CNT TO WS-D4
    MOVE WS-GRAND-END TO WS-D5
    MOVE SPACES TO OUT-SUM-REC
    STRING "-1," FUNCTION TRIM(WS-D2) "," FUNCTION TRIM(WS-D3) ","
           FUNCTION TRIM(WS-D4) "," FUNCTION TRIM(WS-D5)
        INTO OUT-SUM-REC
    WRITE OUT-SUM-REC
    CLOSE OUT-SUM.
